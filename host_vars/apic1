---
# Default target is the private homelab APIC simulator (single tenant, no
# sharing conflicts). If you point ansible_host at the DevNet Always-On
# sandbox instead, change tenant_name (and every tenant: reference below) to
# something unique per team, or you will overwrite other users' data.
tenants:
  - tenant_name: production
    description: 'Production Tenant'
    state: present

vrfs:
  - vrf_name: vrf1
    description: 'Production VRF'
    tenant: production
    policy_direction: ingress
    policy_enforcement: enforced
    state: present

bridge_domains:
  - bd_name: app_bd
    tenant: production
    vrf: vrf1
    state: present
    subnets:
      - subnet_name: app_bd_subnet1
        gateway: 10.0.1.1
        mask: 24
        scope: public
        state: present
  - bd_name: database_bd
    tenant: production
    vrf: vrf1
    state: present
    subnets:
      - subnet_name: database_bd_subnet1
        gateway: 10.0.2.1
        mask: 24
        scope: public
        state: present

application_profiles:
  - ap_name: ap1
    tenant: production
    state: present

epgs:
  - epg_name: app_epg
    tenant: production
    ap: ap1
    bd: app_bd
    state: present
    epg_contracts:
      - contract: app_to_database
        contract_type: consumer
        state: present
  - epg_name: database_epg
    tenant: production
    ap: ap1
    bd: database_bd
    state: present
    epg_contracts:
      - contract: app_to_database
        contract_type: provider
        state: present

filters:
  - filter_name: db_filter
    tenant: production
    description: 'db filter'
    state: present
    filter_entries:
      - entry_name: 'allow_mysql'
        ethertype: ip
        protocol: tcp
        dst_port: 3306
        state: present
      
contracts:
  - contract_name: app_to_database
    tenant: production
    description: 'Communication between app server and database'
    scope: context
    state: present
    subjects:
      - subject_name: allow_app_to_database
        filter: db_filter
        state: present